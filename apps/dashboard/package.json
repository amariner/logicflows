{
  "name": "@logicflows/dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Visor multiplataforma de LogicFlows para web, PWA y Android, con Ionic, Angular y Capacitor.",
  "type": "module",
  "scripts": {
    "dev": "ng serve",
    "build": "ng build",
    "android:sync": "ng build && cp android/config.json www/config.json && cap sync android",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "ng test --watch=false",
    "test:a11y": "ng build && playwright test -c e2e/playwright.config.ts",
    "test:e2e": "playwright test -c e2e/system/playwright.config.ts"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "22.2.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/push-notifications": "^8.1.2",
    "@ionic/angular": "^9.0.5",
    "@logicflows/contract": "workspace:*",
    "angular-auth-oidc-client": "^22.0.1",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "angular-eslint": "^22.5.0",
    "jsdom": "^26.1.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
