{
  "name": "@logicflows/dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Visor multiplataforma de LogicFlows para web, PWA y Android, con Ionic, Angular y Capacitor.",
  "type": "module",
  "scripts": {
    "dev": "ng serve",
    "build": "ng build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "ng test --watch=false",
    "test:a11y": "ng build && playwright test -c e2e/playwright.config.ts",
    "test:e2e": "playwright test -c e2e/system/playwright.config.ts",
    "serve:ssr:dashboard": "node www/server/server.mjs"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.0",
    "@ionic/angular": "^9.0.5",
    "@logicflows/contract": "workspace:*",
    "angular-auth-oidc-client": "^22.0.1",
    "compression": "^1.8.2",
    "express": "^5.1.0",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.1",
    "@types/node": "^22.12.0",
    "angular-eslint": "^22.5.0",
    "jsdom": "^26.1.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
