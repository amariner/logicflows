{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "messageId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "siteId": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,32}$"
    },
    "cellId": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,32}$"
    },
    "sessionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "boxesTotal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "palletsTotal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "pallet": {
      "type": "object",
      "properties": {
        "currentLayer": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "layersPerPallet": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "boxesInLayer": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "boxesPerLayer": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "currentLayer",
        "layersPerPallet",
        "boxesInLayer",
        "boxesPerLayer"
      ]
    },
    "cycleTimeMs": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "throughputBoxesPerHour": {
      "type": "number",
      "minimum": 0
    },
    "robot": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "IDLE",
            "MOVING",
            "FAULT"
          ]
        }
      },
      "required": [
        "state"
      ]
    },
    "conveyor": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "STOPPED",
            "RUNNING",
            "FAULT"
          ]
        }
      },
      "required": [
        "state"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "messageId",
    "siteId",
    "cellId",
    "sessionId",
    "timestamp",
    "seq",
    "boxesTotal",
    "palletsTotal",
    "pallet",
    "cycleTimeMs",
    "throughputBoxesPerHour",
    "robot",
    "conveyor"
  ]
}
