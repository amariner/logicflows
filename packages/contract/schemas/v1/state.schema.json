{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "messageId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "siteId": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,32}$"
    },
    "cellId": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,32}$"
    },
    "sessionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "state": {
      "type": "string",
      "enum": [
        "STOPPED",
        "STARTING",
        "RUNNING",
        "WAITING",
        "PAUSED",
        "FAULT",
        "EMERGENCY_STOP"
      ]
    },
    "previousState": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "STOPPED",
            "STARTING",
            "RUNNING",
            "WAITING",
            "PAUSED",
            "FAULT",
            "EMERGENCY_STOP"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "event": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "start",
            "started",
            "starved",
            "blocked",
            "supplyRestored",
            "pause",
            "resume",
            "stop",
            "fault",
            "reset",
            "emergencyStop"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "waitingReason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "STARVED",
            "BLOCKED"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "since": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    },
    "activeAlarms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "severity": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "raisedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
          }
        },
        "required": [
          "code",
          "severity",
          "message",
          "raisedAt"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "messageId",
    "siteId",
    "cellId",
    "sessionId",
    "timestamp",
    "seq",
    "state",
    "previousState",
    "event",
    "waitingReason",
    "since",
    "activeAlarms"
  ]
}
