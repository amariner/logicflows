# Variables del entorno local. Copia este fichero a .env (ignorado por Git):
#   cp .env.example .env
# Los valores son solo para desarrollo local; cualquier entorno compartido
# usa credenciales propias.

# Broker MQTT (Eclipse Mosquitto)
# Puertos publicados en 127.0.0.1: MQTT y MQTT sobre WebSocket.
MQTT_PORT=1883
MQTT_WS_PORT=9001
# Contraseña del usuario "api": lee la telemetría.
MQTT_API_PASSWORD=api-local
# Contraseña del usuario "simulator": publica la telemetría.
MQTT_SIMULATOR_PASSWORD=simulator-local

# PostgreSQL
# Puerto publicado en 127.0.0.1.
POSTGRES_PORT=5432
POSTGRES_USER=logicflows
POSTGRES_PASSWORD=logicflows-local
POSTGRES_DB=logicflows
# Conexión de la API con PostgreSQL, con los valores anteriores.
DATABASE_URL=postgres://logicflows:logicflows-local@127.0.0.1:5432/logicflows

# Keycloak, proveedor de identidad (ADR-0009). Puerto publicado en 127.0.0.1.
KEYCLOAK_PORT=8180
# Administrador de la consola de Keycloak, solo para el entorno local.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin-local

# API
API_PORT=3000
# Emisor de los tokens de acceso que acepta la API.
AUTH_ISSUER=http://localhost:8180/realms/logicflows
# Secreto compartido por las instancias de la API para firmar los tiques del
# canal de tiempo real. Al menos 32 caracteres; cada entorno usa el suyo.
REALTIME_TICKET_SECRET=secreto-local-de-tiques-solo-para-desarrollo
# Orígenes autorizados a llamar a la API desde el navegador, separados por comas.
CORS_ORIGINS=http://localhost:4200

# Simulador
# URL del broker para las aplicaciones que se ejecutan fuera de Docker.
MQTT_URL=mqtt://127.0.0.1:1883
SIMULATOR_SITE_ID=demo
SIMULATOR_CELL_ID=cell-01
# Tiempo nominal entre cajas mientras la célula produce, en milisegundos.
SIMULATOR_BOX_INTERVAL_MS=4000
# Variación aleatoria del tiempo de ciclo: 0.1 = ±10 %.
SIMULATOR_CYCLE_VARIATION=0.1
# Tiempo para retirar un pallet completo y colocar uno vacío, en milisegundos.
SIMULATOR_PALLET_CHANGE_MS=8000
# Semilla para repetir exactamente una simulación. Sin valor, cada ejecución varía.
SIMULATOR_SEED=
# Escenario: normal, turno, averias, red-inestable o demo (ver apps/simulator/README.md).
SIMULATOR_SCENARIO=normal
# Tiempo hasta que el operario resuelve un fallo y rearma la célula, en milisegundos.
SIMULATOR_FAULT_RECOVERY_MS=20000
# Tiempo hasta que se libera y rearma una parada de emergencia, en milisegundos.
SIMULATOR_EMERGENCY_STOP_RECOVERY_MS=30000
# Tiempo entre el rearme y la orden de arranque, en milisegundos.
SIMULATOR_RESTART_DELAY_MS=5000
# Duración de la secuencia de arranque, en milisegundos.
SIMULATOR_STARTUP_DURATION_MS=3000
SIMULATOR_LAYERS_PER_PALLET=5
SIMULATOR_BOXES_PER_LAYER=8

# Visor en contenedor (pnpm stack:up). Puerto publicado en 127.0.0.1.
DASHBOARD_PORT=8100

# Registro de la API y del simulador: debug, info, warn o error.
LOG_LEVEL=info

# Token de las métricas de la API (/metrics, ADR-0013). Sin valor, la ruta no
# existe. Para probarlas en local: openssl rand -hex 32
# METRICS_TOKEN=

# Cuenta de servicio de Firebase para los avisos de alarmas en el móvil
# (ADR-0015): el JSON completo en una línea. Sin valor, no se envían avisos.
# FCM_SERVICE_ACCOUNT=

# Histórico (ADR-0016). Cada cuánto se agregan las horas pendientes, y
# retención del dato en bruto en días (0 = sin límite). La retención se activa
# en producción cuando haya copias de seguridad (LF-82): 30 y 365.
# HISTORY_AGGREGATION_INTERVAL_MS=30000
# HISTORY_RAW_RETENTION_DAYS=0
# HISTORY_EVENTS_RETENTION_DAYS=0
# HISTORY_AGGREGATES_RETENTION_DAYS=0

# Ritmo nominal de las células en cajas por hora, base del rendimiento
# (docs/indicadores-de-planta.md), y el de las que no siguen el general.
# NOMINAL_BOXES_PER_HOUR=900
# NOMINAL_BOXES_PER_HOUR_BY_CELL=demo/cell-02=1200
